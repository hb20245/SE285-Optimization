OMP_NUM_THREADS environment is not set. Defaulting to 1 thread. (src/comm.cpp:99)
  using 1 OpenMP thread(s) per MPI task
units           real
dimension       3
boundary        p p p
atom_style      charge

variable        dt             equal 0.25
variable        Tend           equal 2300.0
variable        Tcool          equal 1000.0
variable        Tdamp          equal 100.0
variable        cool_time_ps   equal 1000.0
variable        dump_every_ps  equal 2.0

timestep        ${dt}
timestep        0.25

variable        cool_time_fs   equal ${cool_time_ps}*1000.0
variable        cool_time_fs   equal 1000*1000.0
variable        cool_steps     equal floor(${cool_time_fs}/${dt})
variable        cool_steps     equal floor(1000000/${dt})
variable        cool_steps     equal floor(1000000/0.25)
variable        dump_every_fs  equal ${dump_every_ps}*1000.0
variable        dump_every_fs  equal 2*1000.0
variable        dump_stride    equal floor(${dump_every_fs}/${dt})
variable        dump_stride    equal floor(2000/${dt})
variable        dump_stride    equal floor(2000/0.25)

print "=== COOLING PHASE ==="
=== COOLING PHASE ===
print "Cooling from ${Tend} K to ${Tcool} K"
Cooling from 2300 K to 1000 K
print "Duration = ${cool_time_ps} ps (${cool_steps} steps)"
Duration = 1000 ps (4000000 steps)
print "Output every ${dump_every_ps} ps (${dump_stride} steps)"
Output every 2 ps (8000 steps)

read_restart    03_held.restart
