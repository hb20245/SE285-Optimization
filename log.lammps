pair_style      reaxff lmp_control
pair_coeff      * * ffield.reax.cho H C O
Reading potential file ffield.reax.cho with DATE: 2011-02-18
fix             qeq all qeq/reax 1 0.0 10.0 1.0e-4 param.qeq

thermo_style    custom step temp pe ke etotal press vol
thermo          1000

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

restart         50000 restart_cool.a restart_cool.b

dump            traj all custom ${dump_stride} dump_cool.xyz id type x y z q
dump            traj all custom 8000 dump_cool.xyz id type x y z q
dump_modify     traj element H C O sort id

fix             bonds all reaxff/bonds ${dump_stride} bonds_cool.reax
fix             bonds all reaxff/bonds 8000 bonds_cool.reax

print "=== STARTING COOLING ==="
=== STARTING COOLING ===
fix             cool all nvt temp ${Tend} ${Tcool} ${Tdamp}
fix             cool all nvt temp 2300 ${Tcool} ${Tdamp}
fix             cool all nvt temp 2300 1000 ${Tdamp}
fix             cool all nvt temp 2300 1000 100
run             ${cool_steps}
run             4000000

