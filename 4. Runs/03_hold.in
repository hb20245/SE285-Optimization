units           real
dimension       3
boundary        p p p
atom_style      charge

variable        dt             equal 0.10
variable        Tend           equal 2300.0
variable        Tdamp          equal 100.0
variable        hold_time_ps   equal 200.0

timestep        ${dt}

variable        hold_time_fs   equal ${hold_time_ps}*1000.0
variable        hold_steps     equal floor(${hold_time_fs}/${dt})

print "=== HOLD PHASE ==="
print "Holding at ${Tend} K for ${hold_time_ps} ps (${hold_steps} steps)"

read_restart    02_heated.restart

pair_style      reaxff lmp_control
pair_coeff      * * ffield.reax.cho H C O
fix             qeq all qeq/reax 1 0.0 10.0 1.0e-4 param.qeq

thermo_style    custom step temp pe ke etotal press vol
thermo          1000

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

restart         50000 restart_hold.a restart_hold.b

print "=== STARTING HOLD ==="
fix             hold all langevin ${Tend} ${Tend} ${Tdamp} 12345
run             ${hold_steps}
unfix           hold

print "=== HOLD COMPLETE ==="
write_data      held.data
write_restart   03_held.restart

